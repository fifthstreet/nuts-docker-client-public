# Copy to .env (gitignored). Real values never go in git. Day-to-day changes are made on the dashboard, not here;
# these are first-start defaults (anything saved on the dashboard wins).
TZ=UTC                         # your time zone, e.g. Europe/Berlin or America/New_York (log/event timestamps)
NUT_HOST=192.168.0.10           # the machine running the NUT server (e.g. a Synology NAS); this Docker host must be allowed to connect to it
NUT_PORT=3493
NUT_UPS=ups
# NUTS_HOST_LABEL=            # this server's name in notices, the dashboard heading and Home Assistant. Leave unset: it defaults to the
                               # host's own hostname (compose mounts /etc/hostname), so the same files work on every server.
PUSHOVER_TOKEN=
PUSHOVER_USER=
NUTS_ACTIVE=off                # the shutdown switch: on = shut this host down on a UPS event; off = never (default)
NUTS_REPORT=yes                # while OFF, still send notifications
NUTS_POLL_SECONDS=5            # how often the UPS is read
NUTS_ON_BATTERY_SECONDS=600    # shut down after this long on battery
NUTS_MIN_RUNTIME_SECONDS=300   # ...or when the UPS reports less runtime than this
NUTS_HELPER_DRYRUN=no           # yes = the shutdown helper logs what it would do but never powers the host off (testing)
NUTS_DASH_PORT=8099            # dashboard port inside the container (0 = off); leave as is and use NUTS_DASH_PUBLISH_PORT below
# Optional Home Assistant link (MQTT broker); normally set on the dashboard instead. Empty host = off.
NUTS_MQTT_HOST=
NUTS_MQTT_PORT=1883
NUTS_MQTT_USER=
NUTS_MQTT_PASSWORD=
# Several servers on ONE UPS? Each server publishes its OWN entities (switch, helper, timers...) but the UPS readings are the same
# for all of them: publish those from ONE server only. (See docs/multiple-servers.md.)
NUTS_HA_UPS=yes                # yes = publish the UPS readings (status, battery, runtime, load, voltage, model) to Home Assistant
NUTS_HA_HOST=yes               # yes = publish this server's own entities
NUTS_DASH_URL=                 # e.g. http://192.168.0.20:8099 - this dashboard, linked from the Home Assistant device page
NUTS_DASH_PUBLISH_PORT=8099    # host port for the dashboard (change it if 8099 is taken on this host)
# Optional: only these client IPs/CIDRs may open the dashboard (comma separated). Empty = any client on the network.
NUTS_DASH_ALLOW=
